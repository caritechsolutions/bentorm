APP_NAME=Bentorm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bentorm
DB_USERNAME=bentorm
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Bentorm
# First admin account (seeded by `php artisan db:seed`)
ADMIN_PHONE=
ADMIN_NAME=Administrator

# Deep-link scheme the apps register (payment pages bounce back to <scheme>://payment?...)
APP_DEEPLINK_SCHEME=ridecoop

# OTP — SMS, email and payment gateways are configured in the admin panel (plugins), not here.
OTP_TTL_MINUTES=5
OTP_EXPOSE_CODE=false     # true only for local testing — returns the code in the API response
OTP_STATIC_CODE=          # e.g. 123456 for local testing

# Pricing / routing
DISTANCE_PROVIDER=haversine   # haversine | osrm | google
GOOGLE_MAPS_SERVER_KEY=       # Routes API, Places API (New), Geocoding API — server-side only
GOOGLE_MAPS_CLIENT_KEY=       # map tiles in the web app
OSRM_URL=https://router.project-osrm.org
PRICING_CURRENCY=BBD    # fallback only — each service area has its own currency

# Dispatch
DISPATCH_RADIUS_M=8000
DISPATCH_BATCH_SIZE=3
DISPATCH_OFFER_TTL=20
DISPATCH_MAX_WAVES=4
DISPATCH_HEARTBEAT_TTL=90

# Reverb (WebSockets) — apps connect to REVERB_HOST:REVERB_PORT; NPM proxies wss:// to 127.0.0.1:8081
REVERB_APP_ID=bentorm
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
