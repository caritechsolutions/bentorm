[Unit]
Description=Bentorm Reverb WebSocket server
After=network.target redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/bentorm/backend
ExecStart=/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
